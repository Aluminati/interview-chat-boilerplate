{
	"name": "server",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "npm run check-env && tsx src/index.ts",
		"dev": "npm run check-env && tsx watch src/index.ts",
		"check-env": "tsx src/env.ts",
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src tests"
	},
	"dependencies": {
		"@interview-chat/env-utils": "*",
		"better-sqlite3": "^11.10.0",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.28.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.3",
		"@types/node": "^22.15.0",
		"@types/supertest": "^6.0.3",
		"eslint": "^9.28.0",
		"supertest": "^7.1.0",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.33.0",
		"vitest": "^3.2.2"
	}
}
